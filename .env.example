AUTONOESIS_ENV=local
AUTONOESIS_LOG_LEVEL=INFO
AUTONOESIS_API_HOST=127.0.0.1
AUTONOESIS_API_PORT=8000

# Core infrastructure
AUTONOESIS_DATABASE_URL=postgresql+psycopg://autonoesis:autonoesis@localhost:5432/autonoesis
AUTONOESIS_TEMPORAL_TARGET=localhost:7233
AUTONOESIS_TEMPORAL_NAMESPACE=default
AUTONOESIS_TEMPORAL_TASK_QUEUE=autonoesis

# Object store for immutable Evidence/Artifact payloads
AUTONOESIS_OBJECT_STORE_ENDPOINT=localhost:9000
AUTONOESIS_OBJECT_STORE_ACCESS_KEY=minioadmin
AUTONOESIS_OBJECT_STORE_SECRET_KEY=minioadmin
AUTONOESIS_OBJECT_STORE_BUCKET=autonoesis

# Event bus (when subscribers exist)
# AUTONOESIS_EVENT_BUS_URL=nats://localhost:4222

# Authentication: development | oidc
AUTONOESIS_AUTH_MODE=development

# Production OIDC mode only
AUTONOESIS_OIDC_ISSUER=https://identity.example.com/
AUTONOESIS_OIDC_AUDIENCE=autonoesis
AUTONOESIS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Policy engine
AUTONOESIS_OPA_URL=http://localhost:8181

# Capability Pack auto-loaded at startup
AUTONOESIS_CAPABILITY_PACK=examples/field-service/capability-pack.yaml

# Model provider credentials — injected only into the gateway process
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AUTONOESIS_OPENAI_COMPATIBLE_BASE_URL=

# Telemetry
# AUTONOESIS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
